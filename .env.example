# Скопируйте в .env для локального запуска или воспользуйтесь start-скриптом.
# Для контейнерного запуска создайте отдельный .env.cloud по этому образцу.
# Никогда не публикуйте настоящий токен или пароль в Git.

# Токен бота от @BotFather (обязательно).
BOT_TOKEN=
# Локально можно оставить пустым; в облаке прокси обязателен.
# Примеры: http://user:password@proxy.example:3128 или socks5://proxy.example:1080
# Символы @, :, / в логине/пароле кодируйте как %40, %3A, %2F.
TELEGRAM_PROXY_URL=

# Локально: 127.0.0.1 и опубликованный порт. В облаке: db и 5432.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=bot
POSTGRES_USER=bot
# Скрипт сгенерирует пароль, если поле пустое. После создания БД не меняйте его
# только в env-файле: пароль роли PostgreSQL хранится внутри самой БД.
POSTGRES_PASSWORD=

LOG_LEVEL=INFO
# Служебный HTTP-порт на 127.0.0.1; наружу в облаке не публикуется.
HEALTH_PORT=8080

# Ключ OpenRouter для лабораторной № 1. Заполните локально; не публикуйте.
OPENROUTER_API_KEY=

# OpenRouter: обязательные адрес API и имя модели.
LLM_API_BASE_URL=https://openrouter.ai/api/v1/
LLM_MODEL=nvidia/nemotron-3.5-super-vl:free
# Формат: json_schema, json_object или tool_compatible_json.
# Для Nemotron обязателен native tool call: MCP-инструмент либо локальная submit_final_reply.
# Во всех режимах приложение строго проверяет итоговый ответ по JSON Schema.
LLM_STRUCTURED_OUTPUT_MODE=tool_compatible_json
# Таймаут всего вызова, 1–300 секунд.
LLM_TIMEOUT_SECONDS=60
# Общее время ожидания с повторными попытками, 1–600 секунд (5 минут по умолчанию).
LLM_RETRY_WINDOW_SECONDS=300
# Общий бюджет контекста включает инструкции, историю, текущий запрос и резерв ответа.
LLM_MAX_OUTPUT_TOKENS=2048
HISTORY_MAX_TOKENS=32768
HISTORY_MAX_MESSAGES=24

# Лабораторная № 2: путь к предварительно собранному MCP-серверу.
# Относительный путь считается от рабочей папки бота. Для Release укажите bin/Release.
MCP_SERVER_PATH=mcp/bin/Debug/net10.0/ItmoBot.Mcp.dll
# Таймаут подключения и отдельного MCP-запроса, 1–15 секунд.
MCP_TIMEOUT_SECONDS=15
# MCP_SIGNING_KEY и MCP_POSTGRES_CONNECTION_STRING — служебное окружение дочернего
# процесса. Бот формирует их сам из случайного ключа и POSTGRES_*; здесь не задавать.

# Расписание: по умолчанию Data/schedule.json рядом с DLL MCP-сервера.
# Необязательный override: абсолютный путь или путь от рабочей папки бота.
# SCHEDULE_FILE=/absolute/path/to/schedule.json
SCHEDULE_TIMEZONE=Europe/Moscow

# Open-Meteo: таймаут одной HTTP-попытки, 1–5 секунд; максимум попыток — 1–2.
WEATHER_HTTP_TIMEOUT_SECONDS=5
WEATHER_HTTP_MAX_ATTEMPTS=2
